# .env.example - Template for environment variables

# AZURE OPENAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# COSMOS DB
COSMOS_ENDPOINT=https://your-cosmos-name.documents.azure.com:443/
COSMOS_KEY=your-primary-key-here
COSMOS_DATABASE=agentguard-db
COSMOS_CONTAINER=decision-logs

# CONTENT SAFETY
CONTENT_SAFETY_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-key-here

# FLAGS
USE_AZURE_OPENAI=true
USE_COSMOS_DB=true
USE_CONTENT_SAFETY=false
DEMO_MODE=true
ENABLE_CACHING=true
MAX_DAILY_REQUESTS=1000